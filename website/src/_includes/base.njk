<!DOCTYPE html>
<html lang="{{ t.code }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ t.meta.title }}</title>
<meta name="description" content="{{ t.meta.description }}">
<link rel="alternate" hreflang="uk" href="https://nikitaberezhnyj.github.io/Journi/uk/{{ hrefSuffix }}">
<link rel="alternate" hreflang="en" href="https://nikitaberezhnyj.github.io/Journi/en/{{ hrefSuffix }}">
<link rel="alternate" hreflang="es" href="https://nikitaberezhnyj.github.io/Journi/es/{{ hrefSuffix }}">
<link rel="alternate" hreflang="fr" href="https://nikitaberezhnyj.github.io/Journi/fr/{{ hrefSuffix }}">
<link rel="alternate" hreflang="x-default" href="https://nikitaberezhnyj.github.io/Journi/en/{{ hrefSuffix }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../styles.css">
<link rel="icon" type="image/png" href="../assets/icon.png">
<script src="../index.js" defer></script>
</head>
<body>

<header id="site-header">
  <div class="header-inner">
    <a class="brand" href="./">
      {% icon "auto_stories", "icon" %}
      Journi
    </a>

    <div class="header-controls">
      <div class="lang-select">
        <select id="language-select">
          {% for l in locales %}
          <option
            value="../{{ l.code }}/{{ hrefSuffix }}"
            data-lang="{{ l.code }}"
            {% if l.code == t.code %}selected{% endif %}
          >
            {{ l.label }}
          </option>
          {% endfor %}
        </select>
      </div>

      <button id="theme-toggle" class="icon-btn" aria-label="{{ t.nav.theme_toggle }}">
        {% icon "light_mode", "icon icon-sun" %}
        {% icon "dark_mode", "icon icon-moon" %}
      </button>
    </div>
  </div>
</header>

{{ content | safe }}

</body>
</html>